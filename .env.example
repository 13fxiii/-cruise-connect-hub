# ============================================================
# BIG CRUISE〽️ — LOCAL DEVELOPMENT ENVIRONMENT
# Production secrets belong in AppDeploy Secrets.
# Never commit .env.local or real credentials.
# ============================================================

# ── APP CONFIG ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TERMS_OF_SERVICE_URL=/terms
NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy
COMMUNITY_X_HANDLE=BCHub_
COMMUNITY_X_URL=https://x.com/BCHub_

# ── PAYMENTS ──────────────────────────────────────────────────
# Use AppDeploy Secrets for production values.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_KEY_HERE
PAYSTACK_SECRET_KEY=YOUR_SECRET
PAYSTACK_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
FLW_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET
FLW_WEBHOOK_SECRET=YOUR_FLUTTERWAVE_WEBHOOK_SECRET
FLW_CURRENCY=NGN
MIN_WITHDRAWAL_NGN=100
NEXT_PUBLIC_MIN_WITHDRAWAL=100

# ── X / COMMUNITY INTEGRATION ───────────────────────────────
# Keep OAuth credentials and bearer tokens in AppDeploy Secrets.
TWITTER_CLIENT_ID=YOUR_CLIENT_ID
TWITTER_CLIENT_SECRET=YOUR_CLIENT_SECRET
X_CLIENT_ID=YOUR_CLIENT_ID
X_CLIENT_SECRET=YOUR_CLIENT_SECRET
TWITTER_BEARER_TOKEN=YOUR_BEARER_TOKEN
XAI_API_KEY=YOUR_XAI_KEY
XAI_MODEL=grok-3-mini

# Community imports/sync should use the current BCH community identity.
COMMUNITY_X_HANDLE=BCHub_
COMMUNITY_X_URL=https://x.com/BCHub_

# ── ADMIN / AUTOMATION ───────────────────────────────────────
# Values should be supplied through AppDeploy Secrets in production.
ADMIN_EMAILS=
ADMIN_USER_IDS=
ADMIN_X_HANDLES=@BCHub_
ADMIN_SECRET_KEY=YOUR_ADMIN_SECRET
CRON_SECRET=YOUR_LONG_RANDOM_SECRET

# ── MEDIA / ENTERTAINMENT ────────────────────────────────────
NEXT_PUBLIC_CRUISE_CINEMA_URL=

# ── OPTIONAL ANALYTICS ───────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Production X, payment, AI, email and admin secrets must NOT be stored here.
# AppDeploy Secrets is the canonical production secret store.
